{
  "name": "sqrc",
  "version": "0.2.3",
  "description": "Styled QRCode",
  "keywords": [
    "qr",
    "qrcode",
    "style qr",
    "styled"
  ],
  "homepage": "https://github.com/monodyle/sqrc#readme",
  "bugs": "https://github.com/monodyle/sqrc/issues",
  "license": "MIT",
  "author": "monodyle <monodylh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monodyle/sqrc.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node test/browser/run-browser-test.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "@rslib/core": "^0.23.1",
    "@types/node": "^26.1.0",
    "@types/qrcode": "^1.5.6",
    "playwright": "1.61.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "zxing-wasm": "^3.1.3"
  },
  "peerDependencies": {
    "@napi-rs/canvas": "^1.0.2"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    }
  }
}
